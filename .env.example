# Mapbox public access token (pk.…). Create one at https://account.mapbox.com/ and
# restrict its allowed URLs to your GitHub Pages origin and http://localhost:*.
# Copy this file to .env and fill in the value. .env is git-ignored.
VITE_MAPBOX_TOKEN=

# Optional: GitHub sign-in + cloud sync. See docs/accounts-setup.md.
# Supabase → Project Settings → API: the project URL and the *publishable* (or anon) key.
# Never put the secret / service_role key here — it would ship to every browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
